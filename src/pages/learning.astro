---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { getProjects, url } from '../lib/projects';
const page = await getEntry('pages', 'learning');
const { Content } = await render(page);
const projects = await getProjects();
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
---
<Base title="What I'm Learning" ground="pink" current="learning">
  <div slot="hero" class="wrap" style="padding-top: 40px; padding-bottom: 64px;">
    <p class="label" style="margin: 0 0 16px;">Updated {page.data.updated}</p>
    <h1 class="display" style="font-size: clamp(40px, 6vw, 72px);">What I'm learning, <span class="pop">{page.data.phrase}.</span></h1>
    <p style="max-width: 50ch; margin: 20px 0 0;">The questions I'm carrying from my work, where they came from, and the projects where I've tested them in public.</p>
  </div>
  <section class="wrap" style="padding-top: 56px; padding-bottom: 40px;">
    <h2 class="label muted" style="padding-bottom: 10px; border-bottom: 1px solid var(--rule);">Questions I'm carrying</h2>
    <ol class="qs">
      {page.data.questions?.map((q, i) => (
        <li class="fade">
          <span class="label n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="q">{q.q}</p>
            <p class="from">{q.from}</p>
            {q.links.length > 0 && (
              <p class="label links">Tested in: {q.links.filter((l) => byId[l]).map((l, j) => (<>{j > 0 && ' · '}<a href={url(`/work/${l}/`)}>{byId[l].data.title}</a></>))}</p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
  <section class="wrap" style="padding-bottom: 96px;">
    <div class="prose"><Content /></div>
  </section>
</Base>
<style>
  .qs { list-style: none; margin: 0; padding: 0; }
  .qs li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; padding: 28px 0; border-bottom: 1px solid var(--rule); }
  .n { color: var(--plum); padding-top: 8px; }
  .q { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.25; font-weight: 600; margin: 0 0 10px; max-width: 34ch; }
  .from { margin: 0 0 10px; color: var(--ink-soft); max-width: var(--measure); }
  .links { margin: 0; color: var(--ink-muted); }
  .prose { max-width: var(--measure); }
  .prose :global(h2) { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--plum); margin: 40px 0 12px; }
  .prose :global(ul) { padding-left: 20px; }
</style>
