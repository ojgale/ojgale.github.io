---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getProjects, projectUrl } from '../lib/projects';
import { img } from '../lib/images';
import site from '../site.config.json';

// The first tile is the big one (4 of 6 columns); the second shares its row.
const projects = (await getProjects()).filter((p) => p.data.featured);
const tiles = [
  ...projects.map((p) => ({
    title: p.data.shortTitle ?? p.data.title.replace(/\s*\n\s*/g, ' '),
    href: projectUrl(p.id),
    color: p.data.tileColor,
    image: p.data.tileImage ?? p.data.heroImage,
    position: p.data.tilePosition,
  })),
  ...site.comingSoon.map((c) => ({ title: c.title, href: undefined, color: 'stone' as const, image: c.image, position: c.position })),
];
const withStamps = await Promise.all(tiles.map(async (t) => ({
  ...t,
  stamp: (await getImage({ src: img(t.image), width: 224, format: 'webp', quality: 60 })).src,
})));
---
<Base>
  <div class="home">
      <section aria-label="Introduction" class="wrap intro">
        <h1>Olivia <em>Gale</em></h1>
        <div class="intro-text">
          <span class="label">{site.eyebrow}</span>
          <p>{site.positioning} <em>{site.positioningPop}</em></p>
        </div>
      </section>

      <section id="work" aria-label="Selected work" class="wrap tiles" data-trail>
        {withStamps.map((t, i) => {
          const Tag = t.href ? 'a' : 'div';
          return (
            <Tag
              href={t.href}
              class:list={['tile', 'band', { big: i === 0, tall: i < 2, soon: !t.href }]}
              data-band={t.color}
              data-stamp={t.stamp}
              role={t.href ? undefined : 'link'}
              aria-disabled={t.href ? undefined : 'true'}
            >
              <Image class="tile-img" src={img(t.image)} alt="" aria-hidden="true" widths={[400, 800, 1200]} sizes={i === 0 ? '(max-width: 760px) 100vw, 730px' : '(max-width: 760px) 100vw, 360px'} format="webp" quality={65} loading={i < 2 ? 'eager' : 'lazy'} style={`object-position: ${t.position}`} />
              <div class="grain tile-grain" aria-hidden="true"></div>
              <div class="tile-content">
                {!t.href && <span class="badge">Coming soon</span>}
                <span class="tile-title">{t.title}</span>
              </div>
            </Tag>
          );
        })}
        <div class="trail" aria-hidden="true"></div>
      </section>

      <section aria-label="By the numbers" class="numbers">
        <div class="wrap numbers-grid">
          {site.numbers.map((x) => (
            <div class="number"><span class="number-n"><b>{x.n}</b></span><span class="label">{x.label}</span></div>
          ))}
        </div>
      </section>
  </div>
</Base>

<script>
  // Cursor trail: up to 7 small stamps of the hovered tile's photo follow the mouse.
  const grid = document.querySelector<HTMLElement>('[data-trail]');
  const layer = grid?.querySelector<HTMLElement>('.trail');
  const canTrail = matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (grid && layer && canTrail) {
    const MAX = 7, SPACING = 56;
    let pts: { x: number; y: number; img: string }[] = [];
    const draw = () => {
      layer.replaceChildren(...pts.map((p, i) => {
        const age = pts.length - 1 - i;
        const s = document.createElement('span');
        s.className = 'stamp';
        s.style.backgroundImage = `url(${p.img})`;
        s.style.opacity = String(Math.max(0, 1 - age * 0.15));
        s.style.transform = `translate(${p.x - 56}px, ${p.y - 40}px) scale(${1 - age * 0.12}) rotate(${i % 2 ? 3 : -3}deg)`;
        return s;
      }));
    };
    grid.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (!tile?.dataset.stamp) return;
      const r = grid.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      const last = pts[pts.length - 1];
      if (last && Math.abs(last.x - x) + Math.abs(last.y - y) <= SPACING) return;
      pts = [...pts, { x, y, img: tile.dataset.stamp }].slice(-MAX);
      draw();
    });
    grid.addEventListener('pointerleave', () => { pts = []; draw(); });
  }
</script>

<style is:global>
  .intro { padding-top: 36px; padding-bottom: 56px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; }
  .intro h1 { flex: 999 1 560px; min-width: 0; margin: 0; font-size: clamp(72px, 13vw, 176px); line-height: 0.9; letter-spacing: -0.03em; font-weight: 400; }
  .intro h1 em, .intro p em { color: var(--accent); font-weight: 400; }
  .intro, .tiles { transition: color 300ms; }
  .intro-text { flex: 1 1 280px; display: flex; flex-direction: column; gap: 14px; padding-bottom: 14px; }
  .intro-text p { margin: 0; font-size: 20px; line-height: 1.4; }

  .tiles { position: relative; padding-bottom: 72px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .tile { grid-column: span 2; min-height: 280px; position: relative; overflow: hidden; padding: 24px; text-decoration: none; }
  .tile.big { grid-column: span 4; }
  .tile.tall { min-height: 360px; }
  .tile-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15); mix-blend-mode: luminosity; opacity: var(--photo-opacity); transition: opacity 300ms; }
  .tile-grain { transition: opacity 300ms; }
  .tile:hover .tile-img, .tile:focus-visible .tile-img { opacity: 0; }
  .tile:hover .tile-grain, .tile:focus-visible .tile-grain { opacity: 0.45; }
  .tile:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .tile-content { position: relative; display: flex; flex-direction: column; height: 100%; gap: 24px; }
  .badge { font-family: var(--mono); font-size: 20px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; align-self: flex-start; padding: 8px 14px; background: var(--paper); color: var(--ink); }
  .tile-title { background: var(--band-bg); color: var(--band-fg); margin-top: auto; font-size: 26px; line-height: 1.1; letter-spacing: -0.01em; max-width: 16ch; align-self: flex-start; padding: 4px 8px; }
  .tile.big .tile-title { font-size: 44px; }
    .trail { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .stamp { position: absolute; left: 0; top: 0; width: 112px; height: 80px; background: center / cover; filter: grayscale(1) contrast(1.1); mix-blend-mode: var(--stamp-blend); }
  @media (max-width: 760px) {
    .tiles { grid-template-columns: 1fr; }
    .tile, .tile.big { grid-column: auto; }
    .tile.big .tile-title { font-size: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .tile-img, .tile-grain, .numbers { transition: none; } }

  .numbers { background: var(--numbers-bg); color: var(--paper); transition: background-color 300ms; }
  .numbers-grid { padding-top: 48px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; }
  .number { display: flex; flex-direction: column; gap: 6px; }
  .number-n { font-size: 64px; line-height: 1; }
</style>
