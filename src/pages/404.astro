---
import Base from '../layouts/Base.astro';
import { url } from '../lib/projects';
---
<Base title="Not found">
  <section class="phead band" data-band="lilac" aria-label="Page not found">
    <div class="wrap phead-inner">
      <div class="phead-text">
        <span class="label">404</span>
        <h1>This page isn't here.</h1>
        <p class="subtitle">Try the <a href={url('/')}>home page</a> or the <a href={url('/#work')}>work</a>.</p>
      </div>
    </div>
  </section>
</Base>
