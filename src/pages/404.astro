---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { url } from '../lib/projects';
---
<Base title="Not found">
  <header class="phead" style="background: var(--lilac); color: var(--ink);">
    <div class="wrap phead-inner">
      <Nav />
      <div class="phead-text">
        <span class="label">404</span>
        <h1>This page isn't here.</h1>
        <p class="subtitle" style="color: var(--oxblood);">Try the <a href={url('/')}>home page</a> or the <a href={url('/#work')}>work</a>.</p>
      </div>
    </div>
  </header>
  <main id="main"></main>
</Base>
