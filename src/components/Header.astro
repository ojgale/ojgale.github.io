---
import site from '../site.config.json';
import { url } from '../lib/projects';

interface Props {
  /** Which link is underlined: "work" on project pages, "about" on About. */
  current?: 'home' | 'work' | 'about';
}
const { current = 'home' } = Astro.props;
---
<header class="site-header">
  <div class="wrap">
    <nav aria-label="Main" class="nav label">
      <a href={url('/')}>{site.name}</a>
      <span class="nav-links">
        <a href={url('/#work')} class:list={{ current: current === 'work' }}>Work</a>
        <a href={url('/about/')} aria-current={current === 'about' ? 'page' : undefined}>About</a>
        <a href="#contact">Contact</a>
        <button type="button" class="theme-toggle" aria-label="Light mode. Switch to dark mode" data-theme-toggle>
          <span class="knob" aria-hidden="true"></span><span data-theme-label>Light</span>
        </button>
      </span>
    </nav>
  </div>
</header>

<script>
  // Dark mode toggle. Base.astro sets <html data-theme> before first paint from the saved
  // choice, or from prefers-color-scheme when nothing is saved.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = btn?.querySelector('[data-theme-label]');
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    // The spoken name starts with the visible word, then says what a click does.
    btn?.setAttribute('aria-label', dark ? 'Dark mode. Switch to light mode' : 'Light mode. Switch to dark mode');
    btn?.classList.toggle('is-dark', dark);
    if (label) label.textContent = dark ? 'Dark' : 'Light';
  };
  const saved = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
  sync();
  btn?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    sync();
  });
  // Follow the system setting live until the visitor picks a theme themselves.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (saved()) return;
    root.dataset.theme = e.matches ? 'dark' : 'light';
    sync();
  });
</script>

<style>
  .site-header { background: var(--bg); color: var(--fg); transition: background-color 300ms, color 300ms; }
  .site-header .wrap { padding-top: 28px; padding-bottom: 28px; }
  .nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  .nav a { color: var(--fg); text-decoration: none; }
  .nav a[aria-current], .nav a.current { text-decoration: underline; }
  .nav a:hover { color: var(--accent); text-decoration: underline; }
  .nav-links { display: flex; flex-wrap: wrap; gap: 6px 20px; align-items: center; }
  .theme-toggle { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; margin: -6px 0; padding: 6px 10px; border: 1px solid var(--fg); border-radius: 999px; }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .theme-toggle:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .knob { width: 10px; height: 10px; border-radius: 5px; border: 1px solid currentColor; }
  .theme-toggle.is-dark .knob { background: currentColor; }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }
</style>
